{
  "name": "acmcoder",
  "version": "4.2.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first LeetCode-based ACM practice runner",
  "type": "module",
  "bin": {
    "acmcoder": "./bin/acmcoder.js"
  },
  "scripts": {
    "test": "node --test",
    "build:site": "node scripts/build-clients.mjs site",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "node src/server/server.js",
    "cli": "node bin/acmcoder.js",
    "build:clients": "node scripts/build-clients.mjs all",
    "build:store-assets": "node scripts/build-brand.mjs",
    "check:release": "node scripts/check-release.mjs",
    "pack:release": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "0.28.1",
    "fake-indexeddb": "6.2.5",
    "pyodide": "0.29.3"
  },
  "engines": {
    "node": ">=20"
  }
}
